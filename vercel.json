{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,training/**,docs/**,data/**,node_modules/**,package*.json,.venv/**,.pytest_cache/**,**/__pycache__/**,*.ipynb,.github/**,requirements-training.txt,mlruns/**,mlflow.db,mlflow-artifacts/**,scripts/**}"
    }
  },
  "buildCommand": "python vercel_build.py"
}
